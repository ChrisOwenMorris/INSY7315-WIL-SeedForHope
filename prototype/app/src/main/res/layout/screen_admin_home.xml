<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_greeting"
            android:textAppearance="@style/TextAppearance.SeedOfHope.H1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dashboard_subtitle"
            android:textAppearance="@style/TextAppearance.SeedOfHope.Small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_storefront"
            style="@style/Widget.SeedOfHope.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dashboard_view_storefront" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_manager_tools"
            style="@style/Widget.SeedOfHope.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_manager_tools_title"
                    android:textAppearance="@style/TextAppearance.SeedOfHope.H3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/dashboard_manager_tools_subtitle"
                    android:textAppearance="@style/TextAppearance.SeedOfHope.Small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manage_staff_accounts"
                    style="@style/Widget.SeedOfHope.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/nav_admin_users" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/card_stat_1"
                layout="@layout/item_stat_card" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <include
                android:id="@+id/card_stat_2"
                layout="@layout/item_stat_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/card_stat_3"
                layout="@layout/item_stat_card" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <include
                android:id="@+id/card_stat_4"
                layout="@layout/item_stat_card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_recent_orders"
                android:textAppearance="@style/TextAppearance.SeedOfHope.H2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_see_all_orders"
                style="@style/Widget.SeedOfHope.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_see_all_orders" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SeedOfHope.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/paper"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:text="@string/dashboard_col_reference"
                        android:textAppearance="@style/TextAppearance.SeedOfHope.Caption" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:text="@string/dashboard_col_customer"
                        android:textAppearance="@style/TextAppearance.SeedOfHope.Caption" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_col_date"
                        android:textAppearance="@style/TextAppearance.SeedOfHope.Caption" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:text="@string/dashboard_col_total"
                        android:textAppearance="@style/TextAppearance.SeedOfHope.Caption" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/dashboard_col_status"
                        android:textAppearance="@style/TextAppearance.SeedOfHope.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recent_orders_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
