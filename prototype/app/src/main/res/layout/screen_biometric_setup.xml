<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/biometric_title"
        android:textAppearance="@style/TextAppearance.SeedOfHope.H1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/biometric_subtitle"
        android:textAppearance="@style/TextAppearance.SeedOfHope.Body" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginVertical="48dp"
        android:src="@drawable/ic_fingerprint"
        app:tint="@color/forest_700"
        android:contentDescription="@null" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_enable_biometric"
        style="@style/Widget.SeedOfHope.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/biometric_enable_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_maybe_later"
        style="@style/Widget.SeedOfHope.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/biometric_later_button" />

</LinearLayout>
