<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/adminSignInFragment">

    <fragment
        android:id="@+id/adminSignInFragment"
        android:name="za.org.seedofhope.market.ui.login.AdminSignIn"
        android:label="Login"
        tools:layout="@layout/screen_admin_sign_in">
        <action
            android:id="@+id/action_signIn_to_home"
            app:destination="@id/adminHomeFragment"
            app:popUpTo="@id/adminSignInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminHomeFragment"
        android:name="za.org.seedofhope.market.ui.dashboard.AdminHome"
        android:label="Dashboard"
        tools:layout="@layout/screen_admin_home">
        <action
            android:id="@+id/action_home_to_productCatalogue"
            app:destination="@id/productCatalogueFragment" />
        <action
            android:id="@+id/action_home_to_orderBook"
            app:destination="@id/orderBookFragment" />
        <action
            android:id="@+id/action_home_to_teamList"
            app:destination="@id/teamListFragment" />
        <action
            android:id="@+id/action_home_to_orderView"
            app:destination="@id/orderViewFragment" />
    </fragment>

    <fragment
        android:id="@+id/productCatalogueFragment"
        android:name="za.org.seedofhope.market.ui.products.ProductCatalogue"
        android:label="Products"
        tools:layout="@layout/screen_product_catalogue">
        <action
            android:id="@+id/action_productCatalogue_to_productView"
            app:destination="@id/productViewFragment" />
    </fragment>

    <fragment
        android:id="@+id/productViewFragment"
        android:name="za.org.seedofhope.market.ui.products.ProductView"
        android:label="Product details"
        tools:layout="@layout/screen_product_view">
        <argument
            android:name="productId"
            app:argType="integer" />
        <action
            android:id="@+id/action_productView_to_productCatalogue"
            app:destination="@id/productCatalogueFragment"
            app:popUpTo="@id/adminHomeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/orderBookFragment"
        android:name="za.org.seedofhope.market.ui.orders.OrderBook"
        android:label="Orders"
        tools:layout="@layout/screen_order_book">
        <action
            android:id="@+id/action_orderBook_to_orderView"
            app:destination="@id/orderViewFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderViewFragment"
        android:name="za.org.seedofhope.market.ui.orders.OrderView"
        android:label="Order details"
        tools:layout="@layout/screen_order_view">
        <argument
            android:name="orderRef"
            app:argType="string" />
        <action
            android:id="@+id/action_orderView_to_orderBook"
            app:destination="@id/orderBookFragment"
            app:popUpTo="@id/adminHomeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/teamListFragment"
        android:name="za.org.seedofhope.market.ui.users.TeamList"
        android:label="Admin users"
        tools:layout="@layout/screen_team_list" />

</navigation>
