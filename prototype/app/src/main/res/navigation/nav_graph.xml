<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/adminSignInFragment">

    <fragment
        android:id="@+id/adminSignInFragment"
        android:name="za.org.seedofhope.market.ui.login.AdminSignIn"
        android:label="Login"
        tools:layout="@layout/screen_admin_sign_in">
        <action
            android:id="@+id/action_signIn_to_home"
            app:destination="@id/adminHomeFragment"
            app:popUpTo="@id/adminSignInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminHomeFragment"
        android:name="za.org.seedofhope.market.ui.dashboard.AdminHome"
        android:label="Dashboard"
        tools:layout="@layout/screen_admin_home">
        <action
            android:id="@+id/action_home_to_productCatalogue"
            app:destination="@id/productCatalogueFragment" />
        <action
            android:id="@+id/action_home_to_orderBook"
            app:destination="@id/orderBookFragment" />
        <action
            android:id="@+id/action_home_to_teamList"
            app:destination="@id/teamListFragment" />
        <action
            android:id="@+id/action_home_to_orderView"
            app:destination="@id/orderViewFragment" />
        <!-- Storefront entry point: lets staff jump into the customer-facing app (Andisa's screens). -->
        <action
            android:id="@+id/action_adminHome_to_customerHome"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/productCatalogueFragment"
        android:name="za.org.seedofhope.market.ui.products.ProductCatalogue"
        android:label="Products"
        tools:layout="@layout/screen_product_catalogue">
        <action
            android:id="@+id/action_productCatalogue_to_productView"
            app:destination="@id/productViewFragment" />
    </fragment>

    <fragment
        android:id="@+id/productViewFragment"
        android:name="za.org.seedofhope.market.ui.products.ProductView"
        android:label="Product details"
        tools:layout="@layout/screen_product_view">
        <argument
            android:name="productId"
            app:argType="integer" />
        <action
            android:id="@+id/action_productView_to_productCatalogue"
            app:destination="@id/productCatalogueFragment"
            app:popUpTo="@id/adminHomeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/orderBookFragment"
        android:name="za.org.seedofhope.market.ui.orders.OrderBook"
        android:label="Orders"
        tools:layout="@layout/screen_order_book">
        <action
            android:id="@+id/action_orderBook_to_orderView"
            app:destination="@id/orderViewFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderViewFragment"
        android:name="za.org.seedofhope.market.ui.orders.OrderView"
        android:label="Order details"
        tools:layout="@layout/screen_order_view">
        <argument
            android:name="orderRef"
            app:argType="string" />
        <action
            android:id="@+id/action_orderView_to_orderBook"
            app:destination="@id/orderBookFragment"
            app:popUpTo="@id/adminHomeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/teamListFragment"
        android:name="za.org.seedofhope.market.ui.users.TeamList"
        android:label="Admin users"
        tools:layout="@layout/screen_team_list" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="za.org.seedofhope.market.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/screen_settings" />

    <!-- ============ Andisa — customer screens ============ -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="za.org.seedofhope.market.ui.customer.HomeFragment"
        android:label="Home"
        tools:layout="@layout/screen_home">

        <action
            android:id="@+id/action_home_to_shop"
            app:destination="@id/shopFragment" />

        <action
            android:id="@+id/action_home_to_product_detail"
            app:destination="@id/productDetailFragment" />

        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />

    </fragment>

    <fragment
        android:id="@+id/shopFragment"
        android:name="za.org.seedofhope.market.ui.customer.ShopFragment"
        android:label="Shop"
        tools:layout="@layout/screen_shop">

        <argument
            android:name="category"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_shop_to_product_detail"
            app:destination="@id/productDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="za.org.seedofhope.market.ui.customer.ProductDetailFragment"
        android:label="Product details"
        tools:layout="@layout/screen_product_detail">

        <argument
            android:name="productId"
            app:argType="integer" />

        <action
            android:id="@+id/action_productDetail_to_cart"
            app:destination="@id/cartFragment" />

    </fragment>

    <fragment
        android:id="@+id/myOrdersFragment"
        android:name="za.org.seedofhope.market.ui.customer.MyOrdersFragment"
        android:label="My orders"
        tools:layout="@layout/screen_my_orders">

        <action
            android:id="@+id/action_my_orders_to_order_detail"
            app:destination="@id/customerOrderDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/customerOrderDetailFragment"
        android:name="za.org.seedofhope.market.ui.customer.OrderDetailFragment"
        android:label="Order details"
        tools:layout="@layout/screen_my_order_detail">

        <argument
            android:name="orderRef"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="za.org.seedofhope.market.ui.customer.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/screen_profile">

        <action
            android:id="@+id/action_profile_to_change_password"
            app:destination="@id/changePasswordFragment" />

    </fragment>

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="za.org.seedofhope.market.ui.customer.ChangePasswordFragment"
        android:label="Change password"
        tools:layout="@layout/screen_change_password" />

    <!-- ============ Chris — cart / auth / checkout screens ============ -->

    <fragment
        android:id="@+id/cartFragment"
        android:name="za.org.seedofhope.market.ui.CartFragment"
        android:label="Cart"
        tools:layout="@layout/screen_cart">
        <action
            android:id="@+id/action_cart_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="za.org.seedofhope.market.ui.auth.LoginFragment"
        android:label="Log in"
        tools:layout="@layout/screen_login">
        <action
            android:id="@+id/action_login_to_forgotPassword"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_biometricSetup"
            app:destination="@id/biometricSetupFragment" />
        <action
            android:id="@+id/action_login_to_cartSignedIn"
            app:destination="@id/cartSignedInFragment"
            app:popUpTo="@id/cartFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="za.org.seedofhope.market.ui.auth.RegisterFragment"
        android:label="Create account"
        tools:layout="@layout/screen_register">
        <action
            android:id="@+id/action_register_to_biometricSetup"
            app:destination="@id/biometricSetupFragment" />
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="za.org.seedofhope.market.ui.auth.ForgotPasswordFragment"
        android:label="Forgot password"
        tools:layout="@layout/screen_forgot_password">
        <action
            android:id="@+id/action_forgotPassword_to_resetLinkSent"
            app:destination="@id/resetLinkSentFragment" />
    </fragment>

    <fragment
        android:id="@+id/resetLinkSentFragment"
        android:name="za.org.seedofhope.market.ui.auth.ResetLinkSentFragment"
        android:label="Reset link sent"
        tools:layout="@layout/screen_reset_link_sent" />

    <fragment
        android:id="@+id/biometricSetupFragment"
        android:name="za.org.seedofhope.market.ui.auth.BiometricSetupFragment"
        android:label="Enable biometric login"
        tools:layout="@layout/screen_biometric_setup">
        <action
            android:id="@+id/action_biometricSetup_to_cartSignedIn"
            app:destination="@id/cartSignedInFragment"
            app:popUpTo="@id/cartFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/cartSignedInFragment"
        android:name="za.org.seedofhope.market.ui.CartSignedInFragment"
        android:label="Cart"
        tools:layout="@layout/screen_cart_signed_in">
        <action
            android:id="@+id/action_cartSignedIn_to_checkout"
            app:destination="@id/checkoutFragment" />
    </fragment>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="za.org.seedofhope.market.ui.CheckoutFragment"
        android:label="Checkout"
        tools:layout="@layout/screen_checkout">
        <action
            android:id="@+id/action_checkout_to_orderConfirmed"
            app:destination="@id/orderConfirmedFragment"
            app:popUpTo="@id/cartSignedInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/orderConfirmedFragment"
        android:name="za.org.seedofhope.market.ui.OrderConfirmedFragment"
        android:label="Order confirmed"
        tools:layout="@layout/screen_order_confirmed">
        <action
            android:id="@+id/action_orderConfirmed_to_myOrders"
            app:destination="@id/myOrdersFragment" />
        <action
            android:id="@+id/action_orderConfirmed_to_shop"
            app:destination="@id/shopFragment" />
    </fragment>

</navigation>