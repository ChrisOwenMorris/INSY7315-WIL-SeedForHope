<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SeedOfHope" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/forest_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/sage_100</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorError">@color/danger</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/forest_900</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.SeedOfHope.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.SeedOfHope.TextInputLayout</item>
    </style>

    <!-- ============ Typography ============ -->
    <style name="TextAppearance.SeedOfHope.H1" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.SeedOfHope.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontWeight">600</item>
        <item name="android:textColor">@color/ink</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SeedOfHope.H3" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontWeight">600</item>
        <item name="android:textColor">@color/ink</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.SeedOfHope.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.SeedOfHope.Small" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.SeedOfHope.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontWeight">500</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============ Shapes ============ -->
    <style name="ShapeAppearance.SeedOfHope.Card" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.SeedOfHope.Button" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.SeedOfHope.Input" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.SeedOfHope.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">999dp</item>
    </style>

    <style name="ShapeAppearance.SeedOfHope.Thumbnail" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- ============ Card ============ -->
    <style name="Widget.SeedOfHope.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SeedOfHope.Card</item>
    </style>

    <!-- ============ Buttons ============ -->
    <style name="Widget.SeedOfHope.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/forest_700</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.SeedOfHope.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/sage_100</item>
        <item name="android:textColor">@color/forest_700</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.SeedOfHope.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.SeedOfHope.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.SeedOfHope.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/forest_700</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ============ Inputs ============ -->
    <style name="Widget.SeedOfHope.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/forest_700</item>
        <item name="hintTextColor">@color/ink_muted</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="android:textColorHint">@color/ink_muted</item>
    </style>

    <style name="Widget.SeedOfHope.TextInputLayout.ExposedDropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/forest_700</item>
        <item name="hintTextColor">@color/ink_muted</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="android:textColorHint">@color/ink_muted</item>
    </style>

    <!-- ============ Chips ============ -->
    <style name="Widget.SeedOfHope.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="checkedIconVisible">false</item>
    </style>

</resources>
